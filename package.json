{
  "name": "india-festival-dates",
  "version": "0.1.0",
  "description": "Indian festival dates calculated from astronomy and written festival rules, for any year and any place.",
  "license": "MIT",
  "author": "Paperdrop Corp (https://paperdrop.io)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "panchang",
    "hindu-calendar",
    "festivals",
    "tithi",
    "india",
    "calendar"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
